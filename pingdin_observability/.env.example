# pingdin_observability/.env.example
# Copy to .env on the OBSERVABILITY droplet only. Never copy this file
# or its filled-in values onto the main pingdin_platform droplet.

# --- Tailscale ---------------------------------------------------------
# Filled in automatically by scripts/01_tailscale_setup.sh — this
# droplet's own Tailscale IPv4, used to bind every ingestion port so
# nothing here is reachable outside the tailnet.
TAILSCALE_IP=

# --- Grafana -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Once Part 6's tailscale serve is up: https://pingdin-observability.<your-tailnet>.ts.net
# Until then, leave as http://localhost:3000 and reach it via SSH tunnel.
GRAFANA_ROOT_URL=http://localhost:3000

# --- alert_bridge --------------------------------------------------------
# A DIFFERENT bot from any tenant-facing bot — dedicated to this droplet,
# same reasoning capabilities/alerting/owner_alert.py already states for
# OWNER_ALERT_TELEGRAM_BOT_TOKEN. Can be the SAME bot as that one if you
# prefer one bot for all owner-facing alerts — your call, just don't
# reuse a TENANT-facing bot token here.
ALERT_BRIDGE_TELEGRAM_BOT_TOKEN=
ALERT_BRIDGE_TELEGRAM_CHAT_ID=
# BUILD_LOG Journey 25 — the pager. A CRITICAL alert (a service down, the public site down, a disk almost full or filling fast) also rings the phone through Pushover, at
# emergency priority until acknowledged. Use the SAME values as OWNER_ALERT_PUSHOVER_TOKEN and OWNER_ALERT_PUSHOVER_USER in the main droplet's .env (the user value may be a
# delivery-group key, so a second person gets the page too). Leave both empty for no pager.
ALERT_BRIDGE_PUSHOVER_TOKEN=
ALERT_BRIDGE_PUSHOVER_USER=
# Must match OWNER_ALERT_WEBHOOK_TOKEN set on the MAIN droplet's own
# .env (pingdin-edge / pingdin-core) — see main-droplet-companion/README.md.
OWNER_ALERT_WEBHOOK_TOKEN=

# --- Pingdin-DB read-only Grafana datasource (Managed tenants only) -----
# The main droplet's own Tailscale IP — NOT this droplet's.
PINGDIN_DB_TAILSCALE_HOST=
# Password for the pingdin_grafana_ro role — created by
# main-droplet-companion/provision_grafana_ro_role.sh, RUN ON THE MAIN
# DROPLET, not here. Copy the password it prints into this value.
PINGDIN_GRAFANA_RO_PASSWORD=

# BUILD_LOG Journey 16 — optional: ping URL of an EXTERNAL check that scripts/ops_daily_check.sh pings
# when the daily check passes, so a check that stops RUNNING is noticed too. Empty = no ping. A secret.
OPS_CHECK_PING_URL=
