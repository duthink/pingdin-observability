{
  "title": "Pingdin — App Services (edge · core · compute)",
  "uid": "pingdin-app-services",
  "timezone": "Asia/Kolkata",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "pingdin",
    "app"
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total{job=~\"pingdin-edge|pingdin-core|pingdin-compute\"}, job)",
          "refId": "job"
        },
        "definition": "label_values(http_requests_total{job=~\"pingdin-edge|pingdin-core|pingdin-compute\"}, job)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Service up (metrics reaching Prometheus)",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "1 = the main droplet's Alloy is scraping this service's /metrics successfully. Missing or 0 here is what PingdinEdgeDown / PingdinCoreDown / PingdinComputeDown alert on.",
      "targets": [
        {
          "expr": "up{job=~\"pingdin-.*\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "job:http_requests:rate5m{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Requests per second handled by each service (/health and /metrics excluded at source). Plots the recorded series job:http_requests:rate5m (prometheus/recording_rules.yml).",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "5xx error ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "job:http_error_ratio:rate5m{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "axisSoftMax": 0.05
          }
        },
        "overrides": []
      },
      "description": "Share of requests answered 5xx — the SAME recorded series PingdinHighErrorRate alerts on (fires above 5% for 5m), so this panel can never disagree with the alert. 0 = traffic, no errors; blank = no traffic in the window.",
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "p95 request latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "job:http_request_duration_highr_seconds:p95_5m{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "The SAME recorded series PingdinHighRequestLatency alerts on (fires above 20s for 20m, only under real traffic: more than 6 requests a minute), from the high-resolution histogram, which has buckets beyond 3s.",
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests by status class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (job, status) (rate(http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "2xx / 3xx / 4xx / 5xx per service (the instrumentator groups status codes).",
      "id": 5
    },
    {
      "type": "table",
      "title": "Busiest handlers (req/s, last 5m)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(15, sum by (job, handler) (rate(http_requests_total{job=~\"$job\"}[5m])))",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "req/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "req/s",
            "desc": true
          }
        ]
      },
      "description": "Route templates, not raw URLs. Handler 'none' = requests that matched no route.",
      "id": 6
    },
    {
      "type": "table",
      "title": "Handlers returning 5xx (req/s, last 5m)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (job, handler) (rate(http_requests_total{job=~\"$job\",status=~\"5..\"}[5m])) > 0",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "req/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "req/s",
            "desc": true
          }
        ]
      },
      "description": "Empty is good. Use a handler name here to search that route's logs (Loki, {container=\"pingdin-edge\"}) or its traces (Tempo).",
      "id": 7
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Public site — outside probe",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Is each public URL answering a real HTTPS GET, as seen from THIS droplet over the public internet (DNS, TLS, Caddy, and the service behind it)? Checked once a minute. PublicEndpointDown alerts after 3 minutes of DOWN. Independent of the main droplet's own metrics, so it can show DOWN while every other panel is green.",
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-public\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "TLS certificate — days left",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Days until each public certificate expires, as presented to the probe. Caddy renews about 30 days before expiry, so a healthy value is 30-90; PublicCertExpiringSoon warns under 14 (renewal has then been failing for about two weeks).",
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-public\"} - time()) / 86400",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: days",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 14
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Public site — probe response time",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Total time for the outside probe (DNS + connect + TLS + response), per URL. It includes the internet between the two droplets, so it reads slower than the internal p95 above — watch for a step change, not the absolute number.",
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox-public\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}